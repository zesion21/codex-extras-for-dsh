{
  "name": "codex-extras",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "User profile bundle for DeepSeek Harness 0.2.x: the human /review and /fill commands plus the codex-style agent preset (model-aware persona, single editor, review skill).",
  "exports": {
    ".": "./review.js",
    "./review": "./review.js",
    "./fill": "./fill.js",
    "./persona": "./persona.js",
    "./package.json": "./package.json"
  },
  "files": [
    "review.js",
    "fill.js",
    "persona.js",
    "cordis.patch.yml",
    "presets",
    "skills",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/codex-style.patch.yml"
      ]
    }
  }
}
